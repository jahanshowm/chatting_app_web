# randomchat.kr 운영 — Admin Web + API
# deploy-all-randomchat.sh / deploy-admin-randomchat.sh 가 참조

DEPLOY_SSH=root@3.35.204.151
DEPLOY_DOMAIN=randomchat.kr
REMOTE_WEB_DIR=/var/www/randomchat
API_BASE_URL=https://randomchat.kr

REMOTE_BACKEND_DIR=/home/users/randomchat/www
BACKEND_PORT=3000

ENV_PRODUCTION_FILE="$ROOT/.env.production.randomchat"
NGINX_CONF="$ROOT/deploy/nginx/randomchat.kr.conf"
APACHE_CONF="$ROOT/deploy/apache/randomchat.kr.conf"
APACHE_SSL_CONF="$ROOT/deploy/apache/randomchat.kr-ssl.conf"
APACHE_VHOST_PATH=/opt/bitnami/apache/conf/vhosts/randomchat.kr-vhost.conf
APACHE_SSL_VHOST_PATH=/opt/bitnami/apache/conf/vhosts/randomchat.kr-ssl-vhost.conf
# Bitnami LAMP — nginx 대신 Apache
DEPLOY_WEB_SERVER=apache
